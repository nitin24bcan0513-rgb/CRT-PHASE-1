Program-5 print hollow square of any no?
#include<iostream>
using namespace std;
int main()
{
    int n;
    cout<<"Enter no:";
    cin>>n;
    {
        for(int i=1;i<=n;i++)
        {
            for(int j=1;j<=n;j++)
            {
                if(i==1 || i==n || j==1 || j==n)
                cout<<"*";
                else
                cout<<" ";
            }
            cout<<endl;
        }
        return 0;
    }
}
        
    
