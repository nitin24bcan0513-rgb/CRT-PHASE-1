PROGRAM-4 SWAPPING OF 2 VARIABLE'S VALUE USING POINTERS AND USING FUNCTION?
#include<iostream>
using namespace std;
void swapnumber(int *ptr1,int *ptr2)
{
    int temp=*ptr1;
    *ptr1=*ptr2;
    *ptr2=temp;
}
int main()
{
    int a,b;
    cin>>a;
    cin>>b;
    swapnumber(&a,&b);
    cout<<a<<" "<<b;
    return 0;
}




