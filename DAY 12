PROGRAM 2 FACTORIAL?
#include <iostream>
using namespace std;

int factorial(int n) {
    // Base case
    if (n == 0 || n == 1)
        return 1;

    // Recursive call
    return n * factorial(n - 1);
}

int main() {
    cout<<factorial(5);
}
 
