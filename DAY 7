PROGRAM 1 CALL BY VALUE AND CALL BY REFERENCE?
#include<iostream>
using namespace std;

void updatebyvalue(int a)
{
    a=500;
}
void updatebyreference(int &a)
{
    a=500;
}
int main()
{
    int original=100;
    updatebyvalue(original);
    cout<<original<<"\n";
    updatebyreference(original);
    cout<<original;
    return 0;
}



