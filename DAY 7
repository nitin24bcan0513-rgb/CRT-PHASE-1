PROGRAM 3 PROTECTED ACCESS SPECIFIER?
#include<iostream>
using namespace std;

class parent
{
    protected:
    int secretcode=1234;
};
class child : public parent
{
    public:
    void accesslocker()
    {
        cout<<secretcode;
    }
};
int main()
{
    child obj1;
    obj1.accesslocker();
}



PROGRAM 4 PARAMETERIZED CONSTRUCTER?
#include<iostream>
using namespace std;

class student
{
    public:
    string name;
    int age;
    student(string  studentname,int studentage)
    {
        name=studentname;
        age=studentage;
    }
    void introduce()
    {
        cout<<" Hi there,this person name is "<<name<<" and his age is "<<age<<"\n";
    }
