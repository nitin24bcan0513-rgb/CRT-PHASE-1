PROGRAM 1 TYPES OF INHERITANCE?
#include<iostream>
using namespace std;

class vehicle
{
public:
    void start()
    {
        cout << "vehicle starts" << "\n";
    }
};

class car : public vehicle
{
public:
    void drive()
    {
        cout << "car is running" << "\n";
    }
};

int main()
{
    car obj1;
    obj1.drive();
    obj1.start();

    return 0;
}




PROGRAM 2 MULTILEVEL INHERITANCE?
#include<iostream>
using namespace std;

class vehicle
{
    public:
    void start()
    {
        cout<<"vehicle start"<<"\n";
    }
};
class car : public vehicle
{
    public:
    void drive()
    {
        cout<<"car is running"<<"\n";
    }
};
class speedometer : public car
{
    public:
    void speed()
    {
        cout<<"car is running at the speed of 100"<<"\n";
    }
};
int main()
{
    speedometer obj1;

    obj1.start();
    obj1.drive();
    obj1.speed();

    return 0;
}



