#include<iostream>
using namespace std;

class vehicle
{
    public:
    void start()
    {
        cout<<"vehicle start"<<"\n";
    }
};
class car : public vehicle
{
    public:
    void drive()
    {
        cout<<"car is running"<<"\n";
    }
};
