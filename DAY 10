PROGRAM 3 SUM OF 2D ARRAY?
#include<iostream>
using namespace std;
int main()
{
    int arr[2][2];
    int sum=0;

    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            cin>>arr[i][j];
            sum=sum+arr[i][j];
        }
    }
    cout<<sum;
}




PROGRAM 4 SEARCH AN ELEMENT IN A 2D ARRAY?
#include<iostream>
using namespace std;
int main()
{
    int arr[2][2]={{10,29},
    {30,40}};

    int searchelement;
    cin>>searchelement;

    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            if(arr[i][j]==searchelement)
            {
                cout<<i<<" "<<j;
                return 0;
            }
        }
    }
    cout<<"element not found..";
}
        
    return 0;
}
    
